{
  "id": "covenant:apple:self-healing",
  "version": 1,
  "underlyingIntent": "APPLE economic exposure",
  "notes": "Control-sensitive repair profile. A Claim must have verified issuer identity, Token-2022 identity, no active mint-level PermanentDelegate, and an exact proposed route under 500 bps. UNKNOWN fails closed. The 500 bps ceiling is a repair/demo bound, not the Stocklana ACQUIRE ceiling.",
  "rules": [
    {
      "id": "claim.official_issuer_mapping_verified",
      "evidencePath": "passport.properties.officialIssuerMappingVerified",
      "operator": "EQUALS",
      "expected": true,
      "hard": true,
      "minEvidenceClass": "SIGNED_OR_AUTHORITATIVE_OFFCHAIN",
      "onUnknown": "REFUSE",
      "reasonCode": "OFFICIAL_ISSUER_MAPPING_NOT_VERIFIED"
    },
    {
      "id": "claim.token_program",
      "evidencePath": "passport.properties.tokenProgram",
      "operator": "EQUALS",
      "expected": "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
      "hard": true,
      "minEvidenceClass": "ONCHAIN_DETERMINISTIC",
      "onUnknown": "REFUSE",
      "reasonCode": "TOKEN_PROGRAM_NOT_ALLOWED"
    },
    {
      "id": "claim.permanent_delegate_active",
      "evidencePath": "passport.properties.permanentDelegateActive",
      "operator": "EQUALS",
      "expected": false,
      "hard": true,
      "minEvidenceClass": "ONCHAIN_DETERMINISTIC",
      "onUnknown": "REFUSE",
      "reasonCode": "PERMANENT_DELEGATE_NOT_ALLOWED"
    },
    {
      "id": "repair.max_route_impact_bps",
      "evidencePath": "market.priceImpactBps",
      "operator": "LTE",
      "expected": 500,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 30,
      "onUnknown": "REFUSE",
      "reasonCode": "REPAIR_ROUTE_IMPACT_EXCEEDED"
    }
  ]
}
