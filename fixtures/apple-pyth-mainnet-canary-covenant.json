{
  "id": "covenant:apple:pyth-mainnet-canary",
  "version": 1,
  "underlyingIntent": "APPLE ECONOMIC EXPOSURE",
  "notes": "Mainnet-canary research profile. Pyth live evidence must keep the selected tokenized representation close to the Apple reference before any exact transition authority may exist. This is not investment advice.",
  "rules": [
    {
      "id": "claim.official_issuer_mapping_verified",
      "evidencePath": "passport.properties.officialIssuerMappingVerified",
      "operator": "EQUALS",
      "expected": true,
      "hard": true,
      "minEvidenceClass": "SIGNED_OR_AUTHORITATIVE_OFFCHAIN",
      "onUnknown": "REFUSE",
      "reasonCode": "OFFICIAL_ISSUER_MAPPING_NOT_VERIFIED"
    },
    {
      "id": "claim.token_program",
      "evidencePath": "passport.properties.tokenProgram",
      "operator": "EQUALS",
      "expected": "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
      "hard": true,
      "minEvidenceClass": "ONCHAIN_DETERMINISTIC",
      "onUnknown": "REFUSE",
      "reasonCode": "TOKEN_PROGRAM_NOT_ALLOWED"
    },
    {
      "id": "market.pyth_source",
      "evidencePath": "market.source",
      "operator": "EQUALS",
      "expected": "PYTH_PRO",
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 15,
      "onUnknown": "REFUSE",
      "reasonCode": "PYTH_SOURCE_REQUIRED"
    },
    {
      "id": "market.max_tracking_error_bps",
      "evidencePath": "market.trackingErrorBps",
      "operator": "LTE",
      "expected": 75,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 15,
      "onUnknown": "REFUSE",
      "reasonCode": "TRACKING_ERROR_EXCEEDED"
    },
    {
      "id": "market.max_confidence_bps",
      "evidencePath": "market.confidenceBps",
      "operator": "LTE",
      "expected": 25,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 15,
      "onUnknown": "REFUSE",
      "reasonCode": "ORACLE_CONFIDENCE_TOO_WIDE"
    }
  ]
}
