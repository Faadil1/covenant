{
  "id": "covenant:tesla:stocklana-mainnet-canary",
  "version": 1,
  "underlyingIntent": "Maintain Tesla economic exposure through an approved Solana representation",
  "notes": "Fallback Stocklana canary. Pyth TSLA/USD is the live economic reference. Jupiter's executable USDC->TSLAx quote supplies the representation price. COVENANT permits the transition only when the executable price remains close to Tesla, Pyth confidence/freshness pass, and route impact remains bounded.",
  "rules": [
    {
      "id": "claim.official_issuer_mapping_verified",
      "evidencePath": "passport.properties.officialIssuerMappingVerified",
      "operator": "EQUALS",
      "expected": true,
      "hard": true,
      "minEvidenceClass": "SIGNED_OR_AUTHORITATIVE_OFFCHAIN",
      "onUnknown": "REFUSE",
      "reasonCode": "OFFICIAL_ISSUER_MAPPING_NOT_VERIFIED"
    },
    {
      "id": "claim.token_program",
      "evidencePath": "passport.properties.tokenProgram",
      "operator": "EQUALS",
      "expected": "TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb",
      "hard": true,
      "minEvidenceClass": "ONCHAIN_DETERMINISTIC",
      "onUnknown": "REFUSE",
      "reasonCode": "TOKEN_PROGRAM_NOT_ALLOWED"
    },
    {
      "id": "market.pyth_execution_tracking_error_bps",
      "evidencePath": "market.trackingErrorBps",
      "operator": "LTE",
      "expected": 75,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 20,
      "onUnknown": "REFUSE",
      "reasonCode": "PYTH_EXECUTION_TRACKING_ERROR_EXCEEDED"
    },
    {
      "id": "market.pyth_confidence_bps",
      "evidencePath": "market.pythConfidenceBps",
      "operator": "LTE",
      "expected": 50,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 20,
      "onUnknown": "REFUSE",
      "reasonCode": "PYTH_CONFIDENCE_TOO_WIDE"
    },
    {
      "id": "market.pyth_min_publishers",
      "evidencePath": "market.pythPublisherCount",
      "operator": "GTE",
      "expected": 1,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 20,
      "onUnknown": "REFUSE",
      "reasonCode": "PYTH_PUBLISHER_COUNT_TOO_LOW"
    },
    {
      "id": "market.max_price_impact_bps",
      "evidencePath": "market.priceImpactBps",
      "operator": "LTE",
      "expected": 50,
      "hard": true,
      "minEvidenceClass": "LIVE_MARKET_OR_ORACLE",
      "maxAgeSeconds": 20,
      "onUnknown": "REFUSE",
      "reasonCode": "PRICE_IMPACT_EXCEEDED"
    }
  ]
}
