{
  "name": "covenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe:t1": "node scripts/t1-claim-graph.mjs && node scripts/t1-market-evidence.mjs",
    "probe:t3b": "node scripts/t3b-jupiter-build.mjs",
    "test:t2": "node --test test/*.test.mjs",
    "demo:t2": "node scripts/t2-canonical-demo.mjs",
    "preflight:t3b:surfpool": "node scripts/t3b-surfpool-preflight.mjs",
    "probe:routes": "node scripts/t1-route-reality.mjs",
    "prove:t3b:surfpool": "node scripts/t3b-surfpool-execute.mjs",
    "probe:t4:migration-route": "node scripts/t4-migration-route-probe.mjs",
    "prove:t4:self-healing": "node scripts/t4-self-healing-surfpool.mjs",
    "demo:treasury-portability": "node scripts/treasury-portability-demo.mjs",
    "probe:pyth": "node --env-file-if-exists=.env scripts/pyth-stocklana-evidence.mjs",
    "preflight:mainnet": "node --env-file-if-exists=.env scripts/mainnet-canary-preflight.mjs",
    "setup:mainnet-canary": "node --env-file-if-exists=.env scripts/mainnet-canary-setup.mjs",
    "execute:mainnet-canary": "node --env-file-if-exists=.env scripts/mainnet-canary-execute.mjs",
    "probe:pyth:playground": "node scripts/pyth-playground-ingest.mjs",
    "probe:pyth:lazer": "node --env-file-if-exists=.env scripts/pyth-lazer-websocket-check.mjs",
    "probe:tsla-fallback": "node --env-file-if-exists=.env scripts/tsla-fallback-live-check.mjs",
    "preflight:tsla-mainnet": "node --env-file-if-exists=.env scripts/tsla-mainnet-preflight.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@pythnetwork/pyth-lazer-sdk": "7.0.0"
  },
  "devDependencies": {
    "@solana/surfpool": "1.5.0"
  }
}
