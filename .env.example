# Stocklana mainnet canary.
# Default $5; setup/execution scripts hard-refuse values above $20.
COVENANT_MAINNET_POSITION=
COVENANT_MAINNET_INPUT_TOKEN_ACCOUNT=
COVENANT_MAINNET_DESTINATION_TOKEN_ACCOUNT=
COVENANT_MAINNET_INPUT_AMOUNT=5000000
COVENANT_MAINNET_ECONOMIC_VALUE_USD=5
