# Local signing only. Never put the keypair contents in .env or GitHub.
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Destructive-action locks. Leave blank for probes/preflight.
COVENANT_MAINNET_SETUP=
COVENANT_MAINNET_EXECUTE=
